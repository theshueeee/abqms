generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum AccountStatus {
  active
  suspended
  flagged
}

enum StaffRole {
  dental_assistant
  admin
}

enum AppointmentStatus {
  pending
  confirmed
  checked_in
  completed
  cancelled
  no_show
}

enum BookingChannel {
  online
  walk_in
}

enum SuspensionTrigger {
  system
  staff
}

enum SuspensionOutcome {
  pending
  suspended
  reinstated
}

enum SessionActorType {
  patient
  staff
}

model Patient {
  patient_id           String        @id @default(uuid()) @db.Uuid
  full_name            String
  email                String        @unique
  phone_number         String
  password_hash        String
  date_of_birth        DateTime
  account_status       AccountStatus @default(active)
  suspension_reason    String?
  last_known_id_type   String?
  last_known_id_number String?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt
  sessions             Session[]
  reset_tokens         PasswordResetToken[]
  appointments         Appointment[]
  cancelled_appointments Appointment[] @relation("AppointmentCancelledByPatient")
  reschedule_logs      RescheduleLog[]
  suspension_records   SuspensionRecord[]
}

model Staff {
  staff_id       String     @id @default(uuid()) @db.Uuid
  full_name      String
  email          String     @unique
  password_hash  String
  phone_number   String
  role           StaffRole
  is_active      Boolean    @default(true)
  provisioned_by String?    @db.Uuid
  provisioner    Staff?     @relation("StaffProvisioner", fields: [provisioned_by], references: [staff_id])
  provisioned    Staff[]    @relation("StaffProvisioner")
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  sessions       Session[]
  reset_tokens   PasswordResetToken[]
  doctor_blocks  TimeBlock[] @relation("TimeBlockDoctor")
  created_blocks TimeBlock[] @relation("TimeBlockCreator")
  appointments   Appointment[] @relation("AppointmentDoctor")
  cancelled_appointments Appointment[] @relation("AppointmentCancelledByStaff")
  reviewed_suspensions   SuspensionRecord[] @relation("SuspensionReviewer")
}

model AppointmentType {
  appointment_type_id     String        @id @default(uuid()) @db.Uuid
  appointment_type        String
  default_duration_minutes Int
  is_active               Boolean       @default(true)
  appointments            Appointment[]
}

model Appointment {
  appointment_id       String            @id @default(uuid()) @db.Uuid
  patient_id           String            @db.Uuid
  appointment_type_id  String            @db.Uuid
  doctor_staff_id      String            @db.Uuid
  scheduled_datetime   DateTime
  booking_channel      BookingChannel
  status               AppointmentStatus @default(confirmed)
  is_follow_up         Boolean           @default(false)
  parent_appointment_id String?          @db.Uuid
  cancellation_reason_id String?         @db.Uuid
  cancelled_by_patient_id String?        @db.Uuid
  cancelled_by_staff_id String?          @db.Uuid
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  patient              Patient           @relation(fields: [patient_id], references: [patient_id])
  appointment_type     AppointmentType   @relation(fields: [appointment_type_id], references: [appointment_type_id])
  doctor               Staff             @relation("AppointmentDoctor", fields: [doctor_staff_id], references: [staff_id])
  cancellation_reason  CancellationReason? @relation(fields: [cancellation_reason_id], references: [reason_id])
  cancelled_by_patient Patient?        @relation("AppointmentCancelledByPatient", fields: [cancelled_by_patient_id], references: [patient_id])
  cancelled_by_staff   Staff?            @relation("AppointmentCancelledByStaff", fields: [cancelled_by_staff_id], references: [staff_id])
  parent_appointment   Appointment?      @relation("AppointmentFollowUp", fields: [parent_appointment_id], references: [appointment_id])
  follow_ups           Appointment[]     @relation("AppointmentFollowUp")
  reschedule_logs      RescheduleLog[]

  @@index([doctor_staff_id, scheduled_datetime, status])
  @@index([patient_id, scheduled_datetime])
  @@index([appointment_type_id])
}

model Session {
  session_id  String           @id @default(uuid()) @db.Uuid
  token_hash  String           @unique
  actor_type  SessionActorType
  patient_id  String?         @db.Uuid
  staff_id    String?         @db.Uuid
  expires_at  DateTime
  revoked_at  DateTime?
  created_at  DateTime         @default(now())
  patient     Patient?         @relation(fields: [patient_id], references: [patient_id])
  staff       Staff?           @relation(fields: [staff_id], references: [staff_id])

  @@index([patient_id])
  @@index([staff_id])
  @@index([expires_at])
}

model PasswordResetToken {
  token_id    String    @id @default(uuid()) @db.Uuid
  token_hash  String    @unique
  patient_id  String?   @db.Uuid
  staff_id    String?   @db.Uuid
  expires_at  DateTime
  consumed_at DateTime?
  created_at  DateTime  @default(now())
  patient     Patient?  @relation(fields: [patient_id], references: [patient_id])
  staff       Staff?    @relation(fields: [staff_id], references: [staff_id])

  @@index([expires_at])
}

model LoginAttempt {
  attempt_key   String   @id
  failures      Int      @default(0)
  blocked_until DateTime?
  updated_at    DateTime @updatedAt
}

model TimeBlock {
  block_id            String   @id @default(uuid()) @db.Uuid
  doctor_staff_id     String   @db.Uuid
  blocked_by_staff_id String   @db.Uuid
  start_datetime      DateTime
  end_datetime        DateTime
  block_reason        String
  notes               String?
  created_at          DateTime @default(now())
  deleted_at          DateTime?
  doctor              Staff    @relation("TimeBlockDoctor", fields: [doctor_staff_id], references: [staff_id])
  blocked_by          Staff    @relation("TimeBlockCreator", fields: [blocked_by_staff_id], references: [staff_id])

  @@index([doctor_staff_id, start_datetime, end_datetime])
  @@index([doctor_staff_id, deleted_at])
}

model AuditLog {
  log_id     String   @id @default(uuid()) @db.Uuid
  user_id    String
  action     String
  resource   String
  details    Json?
  created_at DateTime @default(now())

  @@index([resource, created_at])
  @@index([user_id, created_at])
}

model CancellationReason {
  reason_id    String        @id @default(uuid()) @db.Uuid
  reason_text  String
  is_active    Boolean       @default(true)
  is_system    Boolean       @default(false)
  appointments Appointment[]

  @@index([is_active, is_system])
}

model RescheduleLog {
  reschedule_id          String      @id @default(uuid()) @db.Uuid
  appointment_id         String      @db.Uuid
  patient_id             String      @db.Uuid
  old_scheduled_datetime DateTime
  new_scheduled_datetime DateTime
  reason                 String
  rescheduled_at         DateTime    @default(now())
  appointment            Appointment @relation(fields: [appointment_id], references: [appointment_id], onDelete: Cascade)
  patient                Patient     @relation(fields: [patient_id], references: [patient_id], onDelete: Cascade)

  @@index([patient_id, rescheduled_at])
  @@index([appointment_id])
}

model SuspensionRecord {
  suspension_id        String            @id @default(uuid()) @db.Uuid
  patient_id           String            @db.Uuid
  flagging_reason      String
  triggered_by         SuspensionTrigger
  flagged_at           DateTime          @default(now())
  reviewed_by_staff_id String?           @db.Uuid
  reviewed_at          DateTime?
  outcome              SuspensionOutcome @default(pending)
  admin_notes          String?
  patient              Patient           @relation(fields: [patient_id], references: [patient_id], onDelete: Cascade)
  reviewed_by          Staff?            @relation("SuspensionReviewer", fields: [reviewed_by_staff_id], references: [staff_id])

  @@index([patient_id, outcome])
}
